# XCapture Server – Konfiguration

# Pflicht: Geheimnis für die Anmelde-Tokens (lange Zufallszeichenkette)
JWT_SECRET=bitte-aendern-lange-zufallszeichenkette

# Port (Standard: 8787)
PORT=8787

# Pfad zur SQLite-Datenbank (Standard: ./data/xcapture.db)
DB_PATH=./data/xcapture.db

# Telegram-Agent: Token von @BotFather (ohne Token bleibt der Bot deaktiviert)
TELEGRAM_BOT_TOKEN=

# Optionaler Server-weiter AI-Fallback, falls ein Nutzer keinen eigenen
# Schlüssel im Konto hinterlegt hat
SERVER_AI_PROVIDER=openai
SERVER_AI_KEY=
